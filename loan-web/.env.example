# Template for local env files. Copy to .env.development and adjust.
#   cp .env.example .env.development
#
# Only VITE_-prefixed vars reach the client, and they are embedded in the
# built bundle — never put a secret in this file.

# Base path for API calls. Defaults to '/api' when unset.
# Keep it relative so the Vite dev proxy handles it (the API has no CORS).
VITE_API_BASE_URL=/api
